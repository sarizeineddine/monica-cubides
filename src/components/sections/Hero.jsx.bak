import { useState } from "react";
import { motion } from "framer-motion";
import { Landmark, ShieldCheck, Award } from "lucide-react";
import { portfolioData } from "@/data/portfolioData";
import { fadeUp, staggerContainer, scaleIn } from "@/animations/motionPresets";
import MagneticButton from "@/components/shared/MagneticButton";

const badgeIcons = [Landmark, ShieldCheck, Award];

function TrustMarquee({ badges }) {
  const loopBadges = [...badges, ...badges];

  return (
    <div className="hero-marquee-mask relative w-full overflow-hidden">
      <div className="hero-marquee-track flex w-max items-center gap-2.5 sm:gap-3">
        {loopBadges.map((badge, i) => {
          const Icon = badgeIcons[i % badgeIcons.length];
          return (
            <div
              key={badge + i}
              className="flex shrink-0 items-center gap-2 rounded-full border px-3 py-1.5 sm:px-3.5 sm:py-2"
              style={{ borderColor: "var(--color-border)", backgroundColor: "var(--color-surface)" }}
            >
              <span
                className="flex h-5 w-5 shrink-0 items-center justify-center rounded-full sm:h-6 sm:w-6"
                style={{ backgroundColor: "var(--color-accent-tint)" }}
              >
                <Icon size={11} style={{ color: "var(--color-accent-dark)" }} />
              </span>
              <span className="whitespace-nowrap text-[8px] font-bold uppercase tracking-[0.13em] text-[color:var(--color-ink)] sm:text-[10px] sm:tracking-[0.15em]">
                {badge}
              </span>
            </div>
          );
        })}
      </div>

      <style>{`
        .hero-marquee-mask {
          -webkit-mask-image: linear-gradient(90deg, transparent 0%, black 6%, black 94%, transparent 100%);
          mask-image: linear-gradient(90deg, transparent 0%, black 6%, black 94%, transparent 100%);
        }
        .hero-marquee-track {
          animation: hero-marquee-scroll 20s linear infinite;
        }
        .hero-marquee-track:hover {
          animation-play-state: paused;
        }
        @keyframes hero-marquee-scroll {
          from { transform: translateX(0); }
          to { transform: translateX(-50%); }
        }
      `}</style>
    </div>
  );
}

function Portrait({ src, alt, fallbackLine1, fallbackLine2 }) {
  const [errored, setErrored] = useState(false);

  return (
    <div className="portrait-frame relative aspect-[3/4] w-full overflow-hidden rounded-[20px] sm:aspect-[4/5] sm:rounded-[28px]">
      {errored ? (
        <div
          className="flex h-full w-full items-center justify-center p-6 text-center text-xs"
          style={{ color: "var(--color-muted)" }}
        >
          {fallbackLine1}
          <br />
          {fallbackLine2}
        </div>
      ) : (
        <img
          src={src}
          alt={alt}
          className="h-full w-full object-cover"
          loading="eager"
          onError={() => setErrored(true)}
        />
      )}
    </div>
  );
}

export default function Hero() {
  const { hero, identity } = portfolioData;

  const scrollTo = (href) => {
    document.querySelector(href)?.scrollIntoView({ behavior: "smooth", block: "start" });
  };

  return (
    <section
      id="inicio"
      className="relative flex items-center overflow-hidden pt-24 pb-10 sm:min-h-[100svh] sm:pt-32 sm:pb-0"
    >
      <div className="mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-10 px-5 sm:gap-16 sm:px-8 lg:grid-cols-[1.1fr_0.9fr] lg:gap-12 lg:px-10">
        <motion.div
          variants={staggerContainer(0.14)}
          initial="hidden"
          animate="show"
          className="flex min-w-0 flex-col items-center text-center"
        >
          <motion.span variants={fadeUp} className="eyebrow-pill mb-4 sm:mb-5">
            {hero.eyebrow}
          </motion.span>

          <motion.h1
            variants={fadeUp}
            className="font-display text-balance max-w-2xl text-[2.5rem] font-semibold leading-[1.08] sm:text-6xl lg:text-[3.75rem]"
            style={{ color: "var(--color-ink)" }}
          >
            {hero.headline}
          </motion.h1>

          <motion.p
            variants={fadeUp}
            className="mt-3 max-w-xl text-balance text-base leading-relaxed text-muted sm:mt-5 sm:text-lg"
          >
            {hero.subheadline}
          </motion.p>

          <motion.div variants={fadeUp} className="mt-5 flex flex-row justify-center gap-2.5 sm:mt-9 sm:gap-4">
            <MagneticButton onClick={() => scrollTo("#proyecciones")}>
              {hero.primaryCTA}
            </MagneticButton>
            <MagneticButton variant="ghost" onClick={() => scrollTo("#respaldo")}>
              {hero.secondaryCTA}
            </MagneticButton>
          </motion.div>

          <motion.div
            variants={fadeUp}
            className="mt-6 w-full max-w-xl border-t pt-4 sm:mt-10 sm:pt-6"
            style={{ borderColor: "var(--color-border)" }}
          >
            <TrustMarquee badges={hero.trustBadges} />
          </motion.div>
        </motion.div>

        <motion.div
          variants={scaleIn}
          initial="hidden"
          animate="show"
          className="relative mx-auto w-full min-w-0 max-w-[240px] sm:max-w-sm lg:max-w-none"
        >
          <Portrait
            src={hero.portrait}
            alt={`${identity.name}, ${identity.role}`}
            fallbackLine1={hero.portraitFallbackLine1}
            fallbackLine2={hero.portraitFallbackLine2}
          />

          <motion.div
            initial={{ opacity: 0, y: 16 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 0.9, duration: 0.7, ease: [0.16, 1, 0.3, 1] }}
            className="hero-badge absolute -left-2 -top-2 z-20 px-2.5 py-2 sm:-left-4 sm:top-8 sm:px-5 sm:py-4 lg:-left-8"
          >
            <p className="font-display text-sm font-semibold currency-display sm:text-2xl" style={{ color: "var(--color-accent-dark)" }}>
              {hero.floatingBadgeOne.value}
            </p>
            <p className="max-w-[5.5rem] text-[8px] uppercase tracking-wide text-muted leading-tight sm:max-w-[9rem] sm:text-[11px] sm:leading-normal">
              {hero.floatingBadgeOne.label}
            </p>
          </motion.div>

          <motion.div
            initial={{ opacity: 0, y: -16 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 1.1, duration: 0.7, ease: [0.16, 1, 0.3, 1] }}
            className="hero-badge absolute -right-2 -bottom-2 z-20 px-2.5 py-2 sm:-right-4 sm:bottom-8 sm:px-5 sm:py-4 lg:-right-8"
          >
            <p className="font-display text-sm font-semibold currency-display sm:text-2xl" style={{ color: "var(--color-ink)" }}>
              {hero.floatingBadgeTwo.value}
            </p>
            <p className="max-w-[5.5rem] text-[8px] uppercase tracking-wide text-muted leading-tight sm:max-w-[9rem] sm:text-[11px] sm:leading-normal">
              {hero.floatingBadgeTwo.label}
            </p>
          </motion.div>
        </motion.div>
      </div>
    </section>
  );
}
