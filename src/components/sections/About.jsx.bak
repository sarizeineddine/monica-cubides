import { motion } from "framer-motion";
import { Calculator, Layers, ShieldCheck } from "lucide-react";
import { portfolioData } from "@/data/portfolioData";
import { fadeUp, staggerContainer, viewportOnce } from "@/animations/motionPresets";
import SectionHeader from "@/components/shared/SectionHeader";

const pillarIcons = {
  calculator: Calculator,
  layers: Layers,
  "shield-check": ShieldCheck,
};

export default function About() {
  const { about } = portfolioData;

  return (
    <section id="sobre-mi" className="section-pad relative">
      <div className="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
        <SectionHeader
          eyebrow={about.eyebrow}
          title={about.headline}
          subtitle={about.lead}
          align="center"
          className="mx-auto"
        />

        <motion.div
          variants={fadeUp}
          initial="hidden"
          whileInView="show"
          viewport={viewportOnce}
          className="mx-auto mt-5 flex max-w-sm flex-col items-center gap-2 text-center sm:mt-7 sm:max-w-none sm:flex-row sm:justify-center sm:gap-3"
        >
          <span
            className="hidden h-px w-10 shrink-0 sm:block"
            style={{ backgroundColor: "var(--color-border-strong)" }}
          />
          <p className="font-display text-xs font-semibold italic leading-snug tracking-wide text-[color:var(--color-accent-dark)] sm:text-sm">
            {about.signatureLine}
          </p>
          <span
            className="hidden h-px w-10 shrink-0 sm:block"
            style={{ backgroundColor: "var(--color-border-strong)" }}
          />
        </motion.div>

        <motion.div
          variants={staggerContainer(0.12)}
          initial="hidden"
          whileInView="show"
          viewport={viewportOnce}
          className="mt-10 grid grid-cols-1 gap-5 sm:mt-14 sm:gap-6 md:grid-cols-3"
        >
          {about.pillars.map((pillar) => {
            const Icon = pillarIcons[pillar.icon] || Calculator;
            return (
              <motion.div
                key={pillar.title}
                variants={fadeUp}
                className="card-panel-bold flex flex-col p-6 sm:p-7"
              >
                <div
                  className="flex h-12 w-12 items-center justify-center rounded-2xl"
                  style={{ backgroundColor: "var(--color-accent-tint)", border: "1px solid var(--color-border)" }}
                >
                  <Icon size={20} className="text-[color:var(--color-accent-dark)]" />
                </div>
                <h3 className="font-display mt-5 text-lg font-semibold text-[color:var(--color-ink)] sm:text-xl">
                  {pillar.title}
                </h3>
                <p className="mt-2.5 text-sm leading-relaxed text-[color:var(--color-muted)]">
                  {pillar.description}
                </p>
              </motion.div>
            );
          })}
        </motion.div>
      </div>
    </section>
  );
}
