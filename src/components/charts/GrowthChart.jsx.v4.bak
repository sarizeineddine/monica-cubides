import { useMemo, useRef, useState } from "react";
import { motion } from "framer-motion";
import {
  AreaChart,
  Area,
  XAxis,
  YAxis,
  ResponsiveContainer,
  CartesianGrid,
  ReferenceDot,
  ReferenceLine,
} from "recharts";

const currency = new Intl.NumberFormat("es-CO", {
  style: "currency",
  currency: "COP",
  maximumFractionDigits: 0,
});
const currencyCompact = new Intl.NumberFormat("es-CO", {
  notation: "compact",
  compactDisplay: "short",
  maximumFractionDigits: 1,
});

export function futureValue(monthly, monthlyRate, months) {
  if (monthlyRate === 0) return monthly * months;
  return monthly * ((Math.pow(1 + monthlyRate, months) - 1) / monthlyRate);
}

export function niceCeil(value) {
  if (value <= 0) return 0;
  const exponent = Math.floor(Math.log10(value));
  const magnitude = Math.pow(10, exponent);
  const fraction = value / magnitude;
  let niceFraction;
  if (fraction <= 1) niceFraction = 1;
  else if (fraction <= 2) niceFraction = 2;
  else if (fraction <= 5) niceFraction = 5;
  else niceFraction = 10;
  return niceFraction * magnitude;
}

const POINT_COUNT = 12;

// Fixed geometry constants — must match the JSX margin/width props below exactly.
// This lets us map a raw pointer/touch X position to a data index ourselves,
// identically for mouse and touch, with zero dependency on Recharts' internal
// hover state machine (which is what caused prior mobile inconsistencies).
const MARGIN_LEFT = 0;
const MARGIN_RIGHT = 8;
const Y_AXIS_WIDTH = 42;

function getIndexFromClientX(clientX, rect, pointCount) {
  const plotLeft = rect.left + Y_AXIS_WIDTH + MARGIN_LEFT;
  const plotRight = rect.right - MARGIN_RIGHT;
  const plotWidth = Math.max(plotRight - plotLeft, 1);
  const ratio = Math.min(Math.max((clientX - plotLeft) / plotWidth, 0), 1);
  return Math.round(ratio * (pointCount - 1));
}

export default function GrowthChart({
  monthly,
  monthlyRate,
  maxMonths = 120,
  domainMax,
  withPlanLabel,
  noPlanLabel,
  rateLabel,
  markers = [],
}) {
  const wrapperRef = useRef(null);
  const [hoverIndex, setHoverIndex] = useState(null);

  const markerMonths = useMemo(() => markers.map((m) => m.months), [markers]);

  const points = useMemo(() => {
    const pts = [];
    for (let i = 0; i <= POINT_COUNT; i++) {
      const months = Math.round((maxMonths / POINT_COUNT) * i);
      const marker = markers.find((m) => m.months === months);
      pts.push({
        months,
        tickLabel: months === 0 ? "Hoy" : marker ? marker.label : `Año ${Math.round(months / 12)}`,
        withPlan: futureValue(monthly, monthlyRate, months),
        noPlan: monthly * months,
      });
    }
    return pts;
  }, [monthly, monthlyRate, maxMonths, markers]);

  // Resting/default state = last point (10 años) — the headline number,
  // always shown even with zero interaction.
  const defaultIndex = points.length - 1;
  const activeIndex = hoverIndex ?? defaultIndex;
  const activePoint = points[activeIndex] ?? points[defaultIndex];

  const updateFromClientX = (clientX) => {
    const el = wrapperRef.current;
    if (!el) return;
    const rect = el.getBoundingClientRect();
    const idx = getIndexFromClientX(clientX, rect, points.length);
    setHoverIndex(idx);
  };

  const handleMouseMove = (e) => updateFromClientX(e.clientX);
  const handleTouchMove = (e) => {
    if (e.touches && e.touches[0]) updateFromClientX(e.touches[0].clientX);
  };
  const resetActive = () => setHoverIndex(null);

  const xTicks = useMemo(() => [0, ...markerMonths], [markerMonths]);
  const xTickFormatter = (months) => {
    if (months === 0) return "Hoy";
    const marker = markers.find((m) => m.months === months);
    return marker ? marker.label : `${months}m`;
  };

  const niceMax = useMemo(() => niceCeil(domainMax), [domainMax]);
  const yTicks = useMemo(() => {
    const stepCount = 4;
    const step = niceMax / stepCount;
    return Array.from({ length: stepCount + 1 }, (_, i) => Math.round(step * i));
  }, [niceMax]);

  return (
    <div className="w-full">
      {/* Always-visible live readout — reflects activeIndex + current slider value */}
      <div
        className="mb-4 flex items-center justify-between gap-3 rounded-xl border px-4 py-3 sm:px-5 sm:py-4"
        style={{ borderColor: "var(--color-border)", backgroundColor: "var(--color-accent-tint)" }}
      >
        <div>
          <p className="text-[9px] font-bold uppercase tracking-[0.16em] text-[color:var(--color-accent-text)]">
            {activePoint.tickLabel}
          </p>
          <p className="mt-1 flex items-center gap-1.5 font-display text-sm font-semibold currency-display sm:text-base" style={{ color: "var(--color-accent-dark)" }}>
            <span className="h-2 w-2 shrink-0 rounded-full" style={{ backgroundColor: "var(--color-accent-dark)" }} />
            {withPlanLabel}: {currency.format(Math.round(activePoint.withPlan))}
          </p>
          <p className="mt-0.5 flex items-center gap-1.5 text-xs currency-display" style={{ color: "var(--color-muted)" }}>
            <span className="h-2 w-2 shrink-0 rounded-full border-2 border-dashed" style={{ borderColor: "var(--color-muted)" }} />
            {noPlanLabel}: {currency.format(Math.round(activePoint.noPlan))}
          </p>
        </div>
        {rateLabel && (
          <span className="shrink-0 text-[10px] font-bold uppercase tracking-[0.18em] text-[color:var(--color-accent-text)]">
            {rateLabel}
          </span>
        )}
      </div>

      <motion.div
        ref={wrapperRef}
        initial={{ opacity: 0, scale: 0.97 }}
        whileInView={{ opacity: 1, scale: 1 }}
        viewport={{ once: true }}
        transition={{ duration: 0.5, ease: [0.16, 1, 0.3, 1] }}
        className="mx-auto aspect-[4/3] w-full max-w-md sm:max-w-lg"
        style={{ touchAction: "pan-y" }}
        onMouseMove={handleMouseMove}
        onMouseDown={handleMouseMove}
        onMouseLeave={resetActive}
        onTouchStart={handleTouchMove}
        onTouchMove={handleTouchMove}
        onTouchEnd={resetActive}
      >
        <ResponsiveContainer width="100%" height="100%">
          <AreaChart data={points} margin={{ top: 24, right: MARGIN_RIGHT, left: MARGIN_LEFT, bottom: 0 }}>
            <defs>
              <linearGradient id="withPlanGradient" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stopColor="var(--color-accent)" stopOpacity={0.32} />
                <stop offset="100%" stopColor="var(--color-accent)" stopOpacity={0} />
              </linearGradient>
              <linearGradient id="noPlanGradient" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stopColor="var(--color-muted)" stopOpacity={0.18} />
                <stop offset="100%" stopColor="var(--color-muted)" stopOpacity={0} />
              </linearGradient>
            </defs>

            <CartesianGrid strokeDasharray="3 3" stroke="var(--color-border)" vertical={false} />

            <XAxis
              dataKey="months"
              type="number"
              domain={[0, maxMonths]}
              ticks={xTicks}
              tickFormatter={xTickFormatter}
              tick={{ fill: "var(--color-muted)", fontSize: 11, fontWeight: 600 }}
              axisLine={false}
              tickLine={false}
            />
            <YAxis
              domain={[0, niceMax]}
              ticks={yTicks}
              tick={{ fill: "var(--color-muted)", fontSize: 10 }}
              axisLine={false}
              tickLine={false}
              tickFormatter={(v) => currencyCompact.format(v)}
              width={Y_AXIS_WIDTH}
            />

            <ReferenceLine
              x={activePoint.months}
              stroke="var(--color-accent-dark)"
              strokeDasharray="4 4"
              strokeWidth={1}
            />

            <Area
              type="monotone"
              dataKey="noPlan"
              stroke="var(--color-muted)"
              strokeWidth={2}
              strokeDasharray="4 3"
              fill="url(#noPlanGradient)"
              isAnimationActive={false}
            />
            <Area
              type="monotone"
              dataKey="withPlan"
              stroke="var(--color-accent-dark)"
              strokeWidth={3}
              fill="url(#withPlanGradient)"
              isAnimationActive={false}
            />

            {markers.map((m) => {
              const pt = points.find((p) => p.months === m.months);
              if (!pt) return null;
              return (
                <ReferenceDot
                  key={m.months}
                  x={m.months}
                  y={pt.withPlan}
                  r={4}
                  fill="var(--color-accent)"
                  stroke="var(--color-surface)"
                  strokeWidth={2}
                  isFront
                />
              );
            })}

            {/* Larger dot marking the currently active/scrubbed point */}
            <ReferenceDot
              x={activePoint.months}
              y={activePoint.withPlan}
              r={6}
              fill="var(--color-accent-dark)"
              stroke="var(--color-surface)"
              strokeWidth={2.5}
              isFront
            />
          </AreaChart>
        </ResponsiveContainer>
      </motion.div>
    </div>
  );
}
